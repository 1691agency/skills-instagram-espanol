  "estructuras": [
    {
      "id": "no-es-solo",
      "regex": "(?i)\\bno (?:es|son) (?:solo|sólo|solamente|simplemente) [^.!?\\n]{2,60}[,.;]\\s*(?:es|son)\\b",
      "name": "\"No es solo X, es Y\"",
      "fix": "Di la única cosa que de verdad quieres decir. Borra la mitad que prepara."
    },
    {
      "id": "no-solo-sino",
      "regex": "(?i)\\bno (?:solo|sólo|solamente)\\b[^.!?\\n]{2,80}\\bsino (?:tambi[eé]n|que)\\b",
      "name": "\"No solo X, sino también Y\"",
      "fix": "Divídelo en dos frases, o quita la mitad más débil."
    },
    {
      "id": "no-se-trata",
      "regex": "(?i)\\bno se trata de [^.!?\\n]{2,60}[.,;]\\s*se trata de\\b|\\b(?:esto )?no es sobre [^.!?\\n]{2,60}[.,;]\\s*es sobre\\b",
      "name": "\"No se trata de X. Se trata de Y.\"",
      "fix": "Empieza por Y. La vuelta es lo que delata."
    },
    {
      "id": "el-resultado",
      "regex": "(?im)^\\s*¿?(?:el resultado|lo mejor|la clave|el truco|el secreto|lo peor|la trampa)\\?\\s*$",
      "name": "Línea de pregunta retórica de una palabra",
      "fix": "Responde en la misma frase en vez de montar una revelación."
    },
    {
      "id": "lo-que-aprendi",
      "regex": "(?i)\\b(?:esto es lo que|aqu[ií] est[aá] lo que|esto fue lo que|ac[aá] est[aá] lo que) (?:aprend[ií]|aprendimos)\\b",
      "name": "\"Esto es lo que aprendí\"",
      "fix": "Di lo que aprendiste. Sáltate el anuncio."
    },
    {
      "id": "triada",
      "regex": "(?i)\\b\\w+, \\w+ y \\w+\\.",
      "name": "Trío de tres (\"rápido, fácil y barato.\")",
      "fix": "Dos cosas o cuatro. Tres es el ritmo por defecto de las máquinas."
    },
    {
      "id": "cohete",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Emoji de cohete / fuego / bombillo / brillos / diana",
      "fix": "Un emoji máximo, y que no sea uno de estos cinco."
    },
    {
      "id": "muro-hashtags",
      "regex": "(?:#\\w+[ \\t]*){6,}",
      "name": "Muro de hashtags (más de 5)",
      "fix": "Instagram ya no permite más de 5 por publicación. Deja de 3 a 5, específicos."
    },
    {
      "id": "como-ia",
      "regex": "(?i)\\bcomo (?:una )?(?:ia|inteligencia artificial|modelo de lenguaje)\\b",
      "name": "La máquina hablando de sí misma",
      "fix": "Borra la frase."
    },
    {
      "id": "en-resumen",
      "regex": "(?im)^\\s*(?:en resumen|en conclusi[oó]n|para concluir|para resumir|en definitiva)\\b",
      "name": "Cierre de ensayo",
      "fix": "Una publicación no necesita un párrafo de conclusión."
    },
    {
      "id": "carnada",
      "regex": "(?im)¿\\s*(?:est[aá]s de acuerdo|qu[eé] opinas|qui[eé]n m[aá]s|me equivoco|t[uú] qu[eé] piensas|y t[uú]|y ustedes)\\s*\\?\\s*$",
      "name": "Carnada de interacción por reflejo",
      "fix": "Haz una pregunta que solo tú podrías hacer, sobre lo concreto que acabas de decir."
    },
    {
      "id": "deja-scroll",
      "regex": "(?im)^\\s*¡?\\s*(?:deja de (?:hacer )?scroll|no (?:hagas|des) scroll|para de (?:hacer )?scroll|espera,? no (?:pases|deslices|hagas scroll|te vayas))",
      "name": "Empezar con \"deja de hacer scroll\"",
      "fix": "Lo que detiene el dedo tiene que ser la idea misma. Pedir atención delata que no te la ganaste."
    },
    {
      "id": "en-este-video",
      "regex": "(?i)\\b(?:en (?:este|el) (?:video|reel|post)(?: de hoy)?|hoy (?:te|les) voy a (?:mostrar|ense[ñn]ar|contar)|(?:te|les) voy a (?:mostrar|ense[ñn]ar) c[oó]mo)\\b",
      "name": "Introducción de video (\"en este video te voy a mostrar\")",
      "fix": "Bórrala y empieza por la recompensa. Los primeros dos segundos deciden todo el reel."
    },
    {
      "id": "emoji-vinetas",
      "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF✅➡⬅✔✨]\\s*\\S",
      "name": "Lista con emojis como viñetas",
      "fix": "Usa un guion o un salto de línea. Las viñetas con emoji son lo que más parece plantilla en un texto."
    },
    {
      "id": "mayusculas",
      "regex": "\\b[A-ZÁÉÍÓÚÑ]{3,}\\b(?:\\s+\\b[A-ZÁÉÍÓÚÑ]{3,}\\b){2,}",
      "name": "Tres o más palabras seguidas en MAYÚSCULAS",
      "fix": "Las mayúsculas son volumen, no resaltador. Una palabra, como mucho."
    },
    {
      "id": "carnada-seguir",
      "regex": "(?i)\\b(?:s[ií]gue(?:me|nos) para m[aá]s|etiqueta a (?:alguien|tu amig[oa]|ese amig[oa])|dale (?:doble tap|like) si|comparte (?:esto )?si|comenta (?:abajo )?si)\\b",
      "name": "Pedir seguir o etiquetar por reflejo",
      "fix": "Pide la única acción que esta publicación se gana. El pedido genérico enseña a ignorar todos los pedidos."
    }
  ]
}
